APP_NAME=DocuMind AI
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/documind_ai

# Groq LLM (https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Local embeddings (downloaded on first use)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Pinecone vector DB (index dimension must equal EMBEDDING_DIM)
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=documind-ai

# Web research. Leave empty to fall back to DuckDuckGo.
TAVILY_API_KEY=

STORAGE_DIR=backend/storage

# Optional limits and deployment switches (defaults shown)
# MAX_UPLOAD_MB=25
# MAX_FILES_PER_SESSION=20
# MAX_SESSION_MB=200
# MAX_CONCURRENT_CHATS=4
# CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false   # unset = secure only when APP_ENV=production; use false for plain-http Docker
# MAX_CONCURRENT_CHATS=4
# TOOL_TIMEOUT_S=30            # hard deadline for each web-search / vector-store call
# PRICE_INPUT_PER_MTOK=0.15    # USD per 1M tokens for GROQ_MODEL; used only to estimate cost in traces and /metrics
# PRICE_OUTPUT_PER_MTOK=0.60
