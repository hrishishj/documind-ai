APP_NAME=DocuMind AI
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/documind_ai

# Groq LLM (https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b

# Local embeddings (downloaded on first use)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Pinecone vector DB (index dimension must equal EMBEDDING_DIM)
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=documind-ai

# Web research. Leave empty to fall back to DuckDuckGo.
TAVILY_API_KEY=

STORAGE_DIR=backend/storage
